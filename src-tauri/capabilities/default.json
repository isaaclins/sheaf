{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read and write notes in Documents/Sheaf",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-print",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    { "identifier": "fs:scope", "allow": [{ "path": "$DOCUMENT/Sheaf" }, { "path": "$DOCUMENT/Sheaf/**" }] }
  ]
}
